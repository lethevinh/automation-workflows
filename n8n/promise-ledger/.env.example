# promise-ledger — services, credentials and placeholders
#
# The published export contains NO credential blocks and NO $env
# references, so this file enumerates what to connect instead of
# extracting it. Attach credentials in the n8n UI
# (Credentials → New → pick the type), then set the three values inside
# the `Workflow Config` code node — no environment variables are read
# by this workflow.

# ── Credentials to attach (n8n credential types) ─────────────────────
#
# Gmail OAuth2 — 6 nodes:
#   Fetch new inbox emails · Label email processed ·
#   Email owner: intake alert · Email owner: daily digest ·
#   Notify owner of queue · Escalate to owner
#   (n8n → Credentials → Gmail → connect with Google OAuth)
#
# Google Sheets OAuth2 — 10 nodes:
#   Create promise ledger · Write Commitments tab · Write Chase-Queue tab ·
#   Write ledger row · Find open row · Read ledger rows ·
#   Queue chase for approval · Mark chased in ledger ·
#   Mark done in ledger · Mark escalated in ledger
#   (n8n → Credentials → Google Sheets → connect with Google OAuth)
#
# OpenAI API key — 2 nodes (model: gpt-4o-mini):
#   Extract promises (AI) · Draft chase email (AI)
OPENAI_API_KEY=

# ── `Workflow Config` code node — the only node you edit ─────────────
# Paste these three values into the `Workflow Config` node's jsCode.
# sheet_id is printed by `Print sheet id + next step` when you run the
# one-click setup lane (`Create promise ledger`) once.
PROMISE_LEDGER_SHEET_ID=PASTE_SPREADSHEET_ID_HERE
# Gmail label ID for the `promises-processed` label — the ID, not the
# name (Gmail URL `…/#label/...` or an n8n Gmail node → label → Get All).
PROMISE_LEDGER_LABEL_ID=PASTE_LABEL_ID_HERE
# Where intake alerts, chase-queue notifications, escalations and the
# morning digest are sent.
PROMISE_LEDGER_OWNER_EMAIL=owner@example.com

# ── Live vs demo ─────────────────────────────────────────────────────
# No env var controls this: each item carries a `live` flag and three IF
# gates (`Live write?`, `Skip is live?`, `Alert is live?`) keep demo
# items away from every external write. The demo code nodes
# (`Demo inbox emails`, `Demo extract (mirrors AI contract)`) set
# live: false — press "Test workflow" to run six sample emails with zero
# credentials. On the hourly lane, `Build extraction prompt` sets
# live: true.
