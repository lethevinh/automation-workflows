# Live-lane credentials (optional) — the shipped core never reads these and
# the demo lane makes no network call. They are the integration points for
# the owner-side mailbox and LLM steps described in the README: a watcher
# that pulls mail into the inbox folder, and a summariser that reads
# ambiguous documents before a human posts them.
MAILBOX_IMAP_HOST=
MAILBOX_IMAP_USER=
MAILBOX_IMAP_PASS=
LLM_API_KEY=
LLM_MODEL=