# Live-lane credentials (optional) — the shipped core never reads these and the
# mock lane makes no network call. They are the integration points for the
# owner-side steps described in the README: an LLM endpoint that classifies
# low-confidence messages and phrases drafts, and the inbox/ticket system the
# routed actions are sent to once a human has approved them.
LLM_API_KEY=
LLM_MODEL=
LLM_ENDPOINT=
INBOX_IMAP_HOST=
INBOX_IMAP_USER=
INBOX_IMAP_PASS=
TICKET_SYSTEM_API_KEY=
